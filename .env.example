DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=senha123
DB_NAME=calculo_juros
# Fuso da sessão MySQL (NOW()/CURRENT_TIMESTAMP). GMT-03:00 fixo é o que o FinOps assume para
# `definidoEm` sem fuso. Use SYSTEM para herdar o fuso do servidor MySQL.
DB_TIMEZONE=-03:00
PORT=3000
# Integração com o financial-operations-service (FinOps). Vazio desliga o envio: as operações
# definidas ficam com finops.status PENDENTE até alguém chamar POST /api/operacoes/:id/finops.
FINOPS_URL=http://localhost:8083
FINOPS_TIMEOUT_MS=5000

# Esteira de Documentos (grupo 6, Python). Vazio = não envia. Padrão deles: http://127.0.0.1:8000
DOCUMENTOS_URL=
